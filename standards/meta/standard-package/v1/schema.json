{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/meta/standard-package/v1/schema.json",
  "title": "Standard Package Agent Entrypoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "lifecycle",
    "owner_surface",
    "agent_entrypoint",
    "artifact",
    "authority",
    "agent_contract",
    "validation",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.standard-package/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+\\.v[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ]
    },
    "owner_surface": {
      "type": "string",
      "minLength": 1
    },
    "agent_entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "canonical_surface"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "canonical_surface": {
          "type": "string",
          "minLength": 1
        },
        "generated_projection": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_claim_types",
        "forbidden_claim_types",
        "precedence"
      ],
      "properties": {
        "owned_claim_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_claim_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "precedence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_instruction",
        "required_inputs",
        "required_sections",
        "optional_sections",
        "output_format",
        "proof_policy"
      ],
      "properties": {
        "final_instruction": {
          "type": "string",
          "minLength": 1
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "uniqueItems": true
        },
        "optional_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "uniqueItems": true
        },
        "decision_tree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_tree_rule"
          }
        },
        "output_format": {
          "type": "string",
          "minLength": 1
        },
        "proof_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include_standard_proof_in_output",
            "include_artifact_evidence",
            "proof_location"
          ],
          "properties": {
            "include_standard_proof_in_output": {
              "type": "boolean"
            },
            "include_artifact_evidence": {
              "type": "string",
              "minLength": 1
            },
            "proof_location": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reviewer_instruction": {
          "type": "string",
          "minLength": 1
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "justification_ref"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "justification_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "review_questions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "universal",
            "conditional"
          ],
          "properties": {
            "universal": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "question",
                  "answered_by",
                  "failure_mode"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "omit_when": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failure_mode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "answered_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              }
            },
            "conditional": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "question",
                  "answered_by",
                  "failure_mode"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "omit_when": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failure_mode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "answered_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "semantic_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "runtime_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "core",
        "roles"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "semantic_rules",
        "template"
      ],
      "properties": {
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_rules": {
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "justifications": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "section": {
      "type": "string",
      "minLength": 1
    },
    "decision_tree_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "include_sections",
        "omit_when"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "include_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "omit_when": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/trigger"
        }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readiness"
          ],
          "properties": {
            "readiness": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urgency"
          ],
          "properties": {
            "urgency": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absent"
          ],
          "properties": {
            "absent": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/trigger"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/trigger"
              }
            }
          }
        }
      ]
    }
  }
}
