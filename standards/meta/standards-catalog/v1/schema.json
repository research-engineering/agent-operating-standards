{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/meta/standards-catalog/v1/schema.json",
  "title": "Standards Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "canonical",
    "catalog_owner",
    "admission_rule",
    "non_claims",
    "standards"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.catalog/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "canonical": {
      "const": true
    },
    "catalog_owner": {
      "type": "string",
      "minLength": 1
    },
    "admission_rule": {
      "type": "string",
      "minLength": 1
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalog_entry"
      }
    }
  },
  "$defs": {
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "status",
        "owner_surface",
        "canonical_schema",
        "applies_to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+\\.v[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "active", "deprecated", "superseded"]
        },
        "owner_surface": {
          "type": "string",
          "minLength": 1
        },
        "canonical_schema": {
          "type": ["string", "null"]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
