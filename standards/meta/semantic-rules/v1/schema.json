{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/meta/semantic-rules/v1/schema.json",
  "title": "Semantic Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard", "scope", "rules"],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.semantic-rules/v1"
    },
    "standard": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+\\.v[0-9]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "invariant", "applies_to", "check", "failure_mode"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-SEM-[0-9]{3,}$"
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "failure_mode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
