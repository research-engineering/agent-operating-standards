{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/meta/repository-binding/v1/schema.json",
  "title": "Repository Standards Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "catalog",
    "canonical",
    "binding_owner",
    "default_policy",
    "adopted_standards",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.repository-binding/v1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "catalog": {
      "type": "string",
      "minLength": 1
    },
    "canonical": {
      "const": true
    },
    "binding_owner": {
      "type": "string",
      "minLength": 1
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_artifacts_win_over_generated_projections",
        "admitted_catalog_entries_only",
        "generated_markdown_is_not_normative_unless_declared"
      ],
      "properties": {
        "canonical_artifacts_win_over_generated_projections": {
          "type": "boolean"
        },
        "admitted_catalog_entries_only": {
          "type": "boolean"
        },
        "generated_markdown_is_not_normative_unless_declared": {
          "type": "boolean"
        }
      }
    },
    "adopted_standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard", "owner_surface"],
        "properties": {
          "standard": {
            "type": "string",
            "minLength": 1
          },
          "owner_surface": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "canonical_artifact": {
            "type": "string",
            "minLength": 1
          },
          "generated_projection": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": ["applies_to"]
          },
          {
            "required": ["canonical_artifact"]
          },
          {
            "required": ["generated_projection"]
          }
        ]
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
