{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/artifacts/pull-request-description/v1/schema.json",
  "title": "Pull Request Description Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "summary",
    "problem",
    "authority_links",
    "changes",
    "validation",
    "risk_and_rollback",
    "non_claims",
    "review_focus"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.pull-request-description/v1"
    },
    "artifact_type": {
      "const": "pull_request_description"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "authority_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "risk_and_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "rollback"],
      "properties": {
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_focus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": ["standard", "issue", "spec", "schema", "evidence", "policy", "other"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["passed", "failed", "not_run"]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
