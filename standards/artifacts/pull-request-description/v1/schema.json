{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/artifacts/pull-request-description/v1/schema.json",
  "title": "Pull Request Description Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "title",
    "summary",
    "context",
    "review_scope",
    "change_profiles",
    "readiness_state"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.pull-request-description/v1"
    },
    "artifact_type": {
      "const": "pull_request_description"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "review_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review_surface"
      }
    },
    "change_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "code_behavior",
          "documentation",
          "configuration",
          "ci",
          "dependency",
          "generated",
          "refactor",
          "test",
          "release",
          "migration",
          "security",
          "visual",
          "formatting",
          "emergency",
          "other"
        ]
      }
    },
    "readiness_state": {
      "enum": ["draft", "ready_for_review", "blocked", "emergency"]
    },
    "impact": {
      "$ref": "#/$defs/impact"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "risk_and_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "rollback"],
      "properties": {
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration_rollout": {
      "type": "string",
      "minLength": 1
    },
    "security_privacy": {
      "type": "string",
      "minLength": 1
    },
    "visual_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_focus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "change_profiles": {
            "contains": {
              "const": "security"
            }
          }
        },
        "required": ["change_profiles"]
      },
      "then": {
        "required": ["security_privacy"]
      }
    },
    {
      "if": {
        "properties": {
          "change_profiles": {
            "contains": {
              "const": "migration"
            }
          }
        },
        "required": ["change_profiles"]
      },
      "then": {
        "required": ["migration_rollout", "risk_and_rollback"]
      }
    },
    {
      "if": {
        "properties": {
          "change_profiles": {
            "contains": {
              "const": "release"
            }
          }
        },
        "required": ["change_profiles"]
      },
      "then": {
        "required": ["migration_rollout", "risk_and_rollback"],
        "anyOf": [
          {
            "required": ["evidence"]
          },
          {
            "required": ["non_claims"]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "change_profiles": {
            "contains": {
              "const": "generated"
            }
          }
        },
        "required": ["change_profiles"]
      },
      "then": {
        "required": ["links"],
        "anyOf": [
          {
            "required": ["evidence"]
          },
          {
            "required": ["non_claims"]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "readiness_state": {
            "const": "draft"
          }
        },
        "required": ["readiness_state"]
      },
      "then": {
        "required": ["review_focus", "non_claims"]
      }
    },
    {
      "if": {
        "properties": {
          "readiness_state": {
            "const": "blocked"
          }
        },
        "required": ["readiness_state"]
      },
      "then": {
        "required": ["review_focus", "non_claims"]
      }
    },
    {
      "if": {
        "properties": {
          "readiness_state": {
            "const": "emergency"
          }
        },
        "required": ["readiness_state"]
      },
      "then": {
        "required": ["risk_and_rollback"],
        "anyOf": [
          {
            "required": ["evidence"]
          },
          {
            "required": ["non_claims"]
          }
        ]
      }
    }
  ],
  "$defs": {
    "review_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "change_type"],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "change_type": {
          "enum": [
            "code",
            "documentation",
            "schema",
            "workflow",
            "configuration",
            "dependency",
            "generated",
            "test",
            "release",
            "other"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "description"],
      "properties": {
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["users", "business", "operators", "developers", "support"]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": ["issue", "standard", "spec", "schema", "evidence", "policy", "incident", "design", "other"]
        },
        "relationship": {
          "enum": [
            "relates_to",
            "references",
            "depends_on",
            "blocks",
            "supersedes",
            "duplicates",
            "fixes",
            "closes",
            "resolves"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "issue"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["relationship"]
          },
          "else": {
            "not": {
              "required": ["relationship"]
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "evidence_class", "claim", "result", "scope", "display_policy"],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": ["platform_check", "local_command", "manual_review", "screenshot", "benchmark", "linked_report", "render_manifest", "not_available"]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["passed", "failed", "observed", "linked", "skipped", "not_run", "not_available"]
        },
        "scope": {
          "$ref": "#/$defs/evidence_scope"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "required_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "display_policy": {
          "enum": ["hide_when_passed", "show_always", "show_when_failed_or_missing", "show_when_review_action_needed"]
        },
        "blocker": {
          "type": ["string", "null"]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_ref"],
      "properties": {
        "head_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
