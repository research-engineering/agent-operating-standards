{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/artifacts/rendered-view/v1/schema.json",
  "title": "Rendered View Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated",
    "sources",
    "renderer",
    "outputs",
    "freshness",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.rendered-view/v1"
    },
    "artifact_type": {
      "const": "rendered_view"
    },
    "generated": {
      "const": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "source_digest",
        "output_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "current"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "output_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "properties": {
        "status": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "output_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "verifier",
                "evidence_ref",
                "source_digest",
                "output_digest",
                "renderer_digest",
                "config_digest"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "independent_reproduction",
                    "verified_attestation"
                  ]
                },
                "verifier": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ref": {
                  "type": "string",
                  "format": "uri"
                },
                "source_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "output_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "renderer_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "config_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "canonical",
            "supporting",
            "template"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "markdown",
            "html",
            "pdf",
            "other"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "freshness": {
            "properties": {
              "status": {
                "const": "current"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "freshness"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "items": {
              "required": [
                "digest"
              ],
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          },
          "outputs": {
            "items": {
              "required": [
                "digest"
              ],
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          },
          "renderer": {
            "required": [
              "identity_digest",
              "config_digest"
            ],
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "freshness": {
            "required": [
              "verification"
            ],
            "properties": {
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "verifier",
                  "evidence_ref",
                  "source_digest",
                  "output_digest",
                  "renderer_digest",
                  "config_digest"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "independent_reproduction",
                      "verified_attestation"
                    ]
                  },
                  "verifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ref": {
                    "type": "string",
                    "format": "uri"
                  },
                  "source_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "output_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "renderer_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "config_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
