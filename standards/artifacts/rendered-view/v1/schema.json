{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/artifacts/rendered-view/v1/schema.json",
  "title": "Rendered View Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated",
    "sources",
    "renderer",
    "outputs",
    "freshness",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.rendered-view/v1"
    },
    "artifact_type": {
      "const": "rendered_view"
    },
    "generated": {
      "const": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": ["string", "null"]
        },
        "command": {
          "type": ["string", "null"]
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at", "source_digest", "output_digest"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "current"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "output_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "properties": {
        "status": {
          "enum": ["current", "stale", "unknown"]
        },
        "checked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "source_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "output_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["canonical", "supporting", "template"]
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["markdown", "html", "pdf", "other"]
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
