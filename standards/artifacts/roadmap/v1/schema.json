{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/artifacts/roadmap/v1/schema.json",
  "title": "Roadmap Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_type",
    "canonical",
    "scope",
    "owner",
    "last_reviewed",
    "review_cadence",
    "authority",
    "items",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-operating-standards.roadmap/v1"
    },
    "doc_type": {
      "const": "roadmap"
    },
    "canonical": {
      "const": true
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "review_cadence": {
      "type": "string",
      "minLength": 1
    },
    "generated_projection": {
      "type": "string",
      "minLength": 1
    },
    "external_board": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns_claim_types", "must_not_define", "conflict_rule"],
      "properties": {
        "owns_claim_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["plan", "priority", "horizon", "intent", "sequencing", "uncertainty"]
          },
          "uniqueItems": true
        },
        "must_not_define": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "requirement",
              "architecture",
              "decision",
              "api_contract",
              "security",
              "runtime_fact",
              "evidence",
              "release_fact",
              "release_guarantee"
            ]
          },
          "uniqueItems": true
        },
        "conflict_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "local_roadmaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception_ref"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "horizon",
        "confidence",
        "owner",
        "planning_claim",
        "authority_links",
        "exit_evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RM-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["exploring", "planned", "active", "deferred", "dropped", "shipped"]
        },
        "horizon": {
          "enum": ["now", "next", "later", "exploring", "none"]
        },
        "confidence": {
          "enum": ["low", "medium", "high", "committed"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "planning_claim": {
          "type": "string",
          "minLength": 1
        },
        "authority_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authority_link"
          }
        },
        "exit_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_link"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception_ref"
          }
        }
      }
    },
    "authority_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "target"],
      "properties": {
        "relation": {
          "enum": ["depends_on", "motivates_change", "planned_in", "blocked_by", "tracked_by"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "required_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": ["review", "test", "schema_validation", "release", "changelog", "manual_check"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "exception_ref": {
      "type": "string",
      "pattern": "^EX-[0-9]{3,}$"
    }
  }
}
