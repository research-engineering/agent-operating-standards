{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/agent-operating-standards/schemas/authority/exception-protocol/v1/schema.json",
  "title": "Agent Operating Standards Exception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "scope",
    "reason",
    "allowed_claim_types",
    "forbidden_claim_types",
    "promotion_gate",
    "owner",
    "non_claims"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EX-[0-9]{3,}$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "allowed_claim_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim_type"
      },
      "uniqueItems": true
    },
    "forbidden_claim_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim_type"
      },
      "uniqueItems": true
    },
    "review_by": {
      "type": "string",
      "format": "date"
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "promotion_gate": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "anyOf": [
    {
      "required": ["review_by"]
    },
    {
      "required": ["review_trigger"]
    }
  ],
  "$defs": {
    "claim_type": {
      "type": "string",
      "enum": [
        "orientation",
        "plan",
        "priority",
        "horizon",
        "intent",
        "sequencing",
        "uncertainty",
        "requirement",
        "architecture",
        "decision",
        "api_contract",
        "security",
        "runtime_fact",
        "evidence",
        "release_fact",
        "release_guarantee",
        "task_detail",
        "agent_instruction"
      ]
    }
  }
}
